APP_ENV=production
PIPELINE_VERSION=0.3.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_BACKEND_ORIGIN=https://api.euachei3d.com.br
ALLOWED_ORIGINS=https://app.euachei3d.com.br
SNAPMAKER_STORAGE_ROOT=/data/SnapMaker3d
# DATABASE_URL is injected automatically by Northflank for the PostgreSQL addon.
# Leave blank here; Northflank sets it at runtime.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
SNAPMAKER_PROFILE_NAME=Snapmaker U1 (perfil conservador)
SNAPMAKER_BUILD_VOLUME_X_MM=270
SNAPMAKER_BUILD_VOLUME_Y_MM=270
SNAPMAKER_BUILD_VOLUME_Z_MM=270
MAX_UPLOAD_SIZE_MB=1024
MAX_PROJECT_FILES=32
MAX_ZIP_ENTRIES=500
MAX_ZIP_DEPTH=8
MAX_TRIANGLES=3000000
STAGE_TIMEOUT_SECONDS=300
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=45
FREE_AI_ENABLED=true
FREE_AI_EXTERNAL_ENABLED=true
FREE_AI_PROVIDER_ORDER=ollama,pollinations,huggingface
AI_GENERATION_TIMEOUT_SECONDS=6
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_TEXT_MODEL=openai-large
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
MASTER_USERNAME=rodrigogrosa
MASTER_PASSWORD=troque-aqui
MASTER_PASSWORD_ALIASES=
AUTH_TOKEN_SECRET=troque-este-segredo-em-producao
AUTH_TOKEN_TTL_HOURS=12
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=https://app.euachei3d.com.br/auth/callback/google
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_REDIRECT_URI=https://app.euachei3d.com.br/auth/callback/apple
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_REDIRECT_URI=https://app.euachei3d.com.br/auth/callback/instagram
